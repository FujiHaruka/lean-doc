diff --git a/DocGen4/Timing.lean b/DocGen4/Timing.lean
new file mode 100644
index 0000000..2328b56
--- /dev/null
+++ b/DocGen4/Timing.lean
@@ -0,0 +1,44 @@
+/-
+Timing instrumentation used to profile the doc-gen4 pipeline.
+
+Enabled only when the environment variable `DOCGEN_TIMING` points at a file; every timed phase
+appends one JSON object per line to that file. Concurrent processes append to the same file, so
+each record carries the PID of the emitting process.
+-/
+import Init.System.IO
+
+namespace DocGen4.Timing
+
+/-- The timing sink, or `none` when instrumentation is disabled. -/
+def sink : IO (Option String) := IO.getEnv "DOCGEN_TIMING"
+
+/-- Appends one record to the timing sink. `extra` values are spliced in as raw JSON. -/
+def emit (phase : String) (nanos : Nat) (extra : List (String × String) := []) : IO Unit := do
+  match ← sink with
+  | none => pure ()
+  | some path =>
+    let pid ← IO.Process.getPID
+    let extraStr := extra.foldl (init := "") fun acc (k, v) => acc ++ s!",\"{k}\":{v}"
+    let line := s!"\{\"phase\":\"{phase}\",\"pid\":{pid},\"us\":{nanos / 1000}{extraStr}}\n"
+    let h ← IO.FS.Handle.mk path .append
+    h.putStr line
+    h.flush
+
+/-- Runs `act`, recording its wall-clock duration under `phase` along with `extra` fields. -/
+@[inline] def timed (phase : String) (extra : List (String × String)) (act : IO α) : IO α := do
+  match ← sink with
+  | none => act
+  | some _ =>
+    let t0 ← IO.monoNanosNow
+    let r ← act
+    let t1 ← IO.monoNanosNow
+    emit phase (t1 - t0) extra
+    return r
+
+/-- `timed` with no extra fields. -/
+@[inline] def timed' (phase : String) (act : IO α) : IO α := timed phase [] act
+
+/-- Quotes a string so it can be spliced into the `extra` field list of `emit`. -/
+def q (s : String) : String := "\"" ++ s ++ "\""
+
+end DocGen4.Timing
