.DS_Store
node_modules/

# Rust build output (Cargo.lock is committed — this ships as a binary)
/target/

# the extractor's native binary and the C it is compiled from (171 MB + 2.7 MB,
# regenerable with extractor/build.sh; Extract.lean is the source and is committed)
/extractor/build/

# session-local scratch
.claude/.resume-pending
.claude/worktrees/

# raw build output of a benchmark run (large, regenerable); the JSONL timing
# logs and *-summary.txt next to it are committed
benchmarks/results/*.log

# machine-local permission grants
.claude/settings.local.json

# compiled page-cache measurement tools (the .c sources are committed)
benchmarks/tools/olean-residency
benchmarks/tools/olean-evict
benchmarks/tools/olean-prefetch

# experiment build output (native binaries + generated C). `experiments/` itself was
# removed on 2026-08-16 (tag `experiments-frozen`), but these build directories were
# never tracked, so a working copy from before the removal still has them on disk.
# Keep ignoring them so an old tree does not suddenly show 1.7 GB of untracked files.
experiments/*/build/
