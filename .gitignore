.DS_Store
node_modules/

# session-local scratch
.claude/.resume-pending
.claude/worktrees/

# raw build output of a benchmark run (large, regenerable); the JSONL timing
# logs and *-summary.txt next to it are committed
benchmarks/results/*.log

# machine-local permission grants
.claude/settings.local.json

# compiled page-cache measurement tools (the .c sources are committed)
benchmarks/tools/olean-residency
benchmarks/tools/olean-evict

# stage-1 experiment build output (native binary + generated C)
experiments/stage1/build/

# stage-2 experiment build output (native binary + generated C)
experiments/stage2/build/

# stage-3 experiment build output (native binary + generated C)
experiments/stage3/build/

# stage-4 experiment build output (native binary + generated C)
experiments/stage4/build/

# stage-4b experiment build output (native binary + generated C)
experiments/stage4b/build/
