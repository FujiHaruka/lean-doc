{
  "name": "litedoc4-assets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The TypeScript behind the generated site's app.js. Built by build.rs; never published.",
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "biome ci .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "26.2.0",
    "happy-dom": "20.11.2",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "fsevents": false
  }
}
