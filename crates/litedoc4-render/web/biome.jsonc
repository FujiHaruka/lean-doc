{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": false,
    "includes": ["src/**/*.ts", "test/**/*.ts", "*.ts", "*.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // The only rule added to `recommended`, for the same reason CLAUDE.md
      // prefers `#[expect(reason = ...)]` over `#[allow]`: `!` erases a real
      // check, so each one has to say why in a `biome-ignore ...: reason`
      // comment — and biome reports that comment as unused the moment the
      // assertion stops being needed.
      //
      // Rules that cannot say what breaks when they fire are deliberately
      // absent. `noExcessiveCognitiveComplexity` fired on `search()` and
      // `scoreBytes()`, whose shape is measured rather than accidental, and
      // `noUndeclaredVariables` duplicates a judgement tsc already makes.
      "style": { "noNonNullAssertion": "error" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  }
}
